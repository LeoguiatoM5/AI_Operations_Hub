# Copie este arquivo para .env e ajuste os valores.
# O .env NUNCA deve ser versionado (ja esta no .gitignore).

# ---------------------------------------------------------------- aplicacao
APP_ENV=local          # local | test | production
API_HOST=127.0.0.1
API_PORT=8000

# ---------------------------------------------------------------- logs
LOG_LEVEL=INFO         # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=console     # console (legivel no dev) | json (producao/agregadores)

# ---------------------------------------------------------------- LLM
# "fake" nao faz chamadas de rede e nao exige chave: e o padrao, para que o projeto
# rode logo apos o clone. Troque para "openai" quando tiver uma chave.
LLM_PROVIDER=fake                 # fake | openai
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.0               # 0.0 = deterministico, importante para avaliacao
LLM_MAX_OUTPUT_TOKENS=1024
LLM_TIMEOUT_SECONDS=30
LLM_MAX_ATTEMPTS=3                # tentativas totais, incluindo a primeira
LLM_RETRY_BASE_DELAY_SECONDS=0.5

# Necessaria apenas quando LLM_PROVIDER=openai. NUNCA versione este valor.
# OPENAI_API_KEY=sk-...

# ---------------------------------------------------------------- RAG
# "fake" vetoriza por hashing de palavras: deterministico, sem rede e sem custo.
# Nao captura sinonimia -- para isso, use "openai".
EMBEDDING_PROVIDER=fake           # fake | openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536         # usado apenas pelo provedor openai
EMBEDDING_DIMENSIONS_FAKE=256

VECTOR_STORE=chroma               # chroma (persistente) | memory (volatil)
CHROMA_PATH=./data/chroma
CHROMA_COLLECTION=knowledge_base

CHUNK_SIZE=1000                   # caracteres por pedaco
CHUNK_OVERLAP=150                 # precisa ser menor que CHUNK_SIZE
RAG_TOP_K=5
# Corte de relevancia. Deixe VAZIO para usar o piso declarado pelo provedor de embedding:
# a escala de similaridade depende do modelo (o vetorizador lexical acerta em torno de
# 0.25, o text-embedding-3-small passa de 0.75), entao um valor fixo aqui rejeitaria tudo
# com um provedor e nada com outro. Preencha apenas para sobrescrever conscientemente.
# RAG_MIN_SCORE=

MAX_UPLOAD_BYTES=10485760         # 10 MiB por arquivo

# ---------------------------------------------------------------- banco de dados
# SQLite no desenvolvimento. Migrar para PostgreSQL e trocar apenas esta URL:
# DATABASE_URL=postgresql+asyncpg://usuario:senha@localhost:5432/aiops
DATABASE_URL=sqlite+aiosqlite:///./data/app.db
DATABASE_ECHO=false               # true imprime todo SQL executado (ruidoso)

# Estado do grafo de agentes, gravado apos cada no. Separado do banco da aplicacao:
# tem outro dono (o LangGraph) e pode ser descartado sem perder o historico de execucoes.
CHECKPOINT_PATH=./data/checkpoints.db

# ---------------------------------------------------------------- notificacoes
# Para onde vao as acoes de escrita aprovadas por um humano.
# "memory" guarda a mensagem em vez de envia-la: da para exercitar o fluxo de aprovacao
# inteiro sem configurar integracao nenhuma. E o padrao.
NOTIFIER=memory                   # memory | slack

# A URL do webhook E a credencial: quem a tem publica no canal. NUNCA versione este valor.
# Como obter: api.slack.com/apps -> Create New App -> Incoming Webhooks -> Add New Webhook
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T00000000/B00000000/XXXXXXXXXXXXXXXX

# Rotulo do canal configurado no webhook. Aparece apenas no comprovante de entrega: o
# destino real e fixado do lado do Slack, e a aplicacao nao consegue consulta-lo.
# SLACK_DESTINATION=#operacoes

NOTIFIER_TIMEOUT_SECONDS=10

# ---------------------------------------------------------------- callback de resultado
# Para onde enviar o resultado de uma execucao que PAUSOU para aprovacao humana. Quem
# chamou /agents/run recebeu "waiting_approval" e foi embora; o resultado de verdade so
# existe depois que uma pessoa decidir, quando ninguem mais esta esperando a resposta.
#
# Vazio desliga o callback -- a presenca da URL e o proprio seletor, para que nao exista
# o estado invalido "callback ligado, destino ausente".
#
# Execucoes que terminam sem pausa NAO passam por aqui: o resultado ja saiu na resposta
# HTTP, e publicar tambem entregaria a mesma informacao duas vezes.
# RESULT_CALLBACK_URL=http://localhost:5678/webhook/hub/resultado

RESULT_CALLBACK_TIMEOUT_SECONDS=10
